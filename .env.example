# Copy to .env and adjust. Real environment variables take precedence.

# development | production
MABIX_ENV=development
# Required in production. Generate: python -c "import secrets; print(secrets.token_hex(32))"
MABIX_SECRET_KEY=

# Admin login. In development the default is admin/admin.
MABIX_ADMIN_USERNAME=admin
# Production: a werkzeug hash. Generate:
#   python -c "from werkzeug.security import generate_password_hash as g; print(g('your-strong-password'))"
MABIX_ADMIN_PASSWORD_HASH=
# Development only (ignored in production):
# MABIX_ADMIN_PASSWORD=
MABIX_SESSION_HOURS=12

# Stock image APIs used by the news pipeline (rotate the keys that were in the old app.py!)
PEXELS_API_KEY=
PIXABAY_API_KEY=

# Local LLM
OLLAMA_HOST=http://127.0.0.1:11434
MABIX_OLLAMA_MODEL=llama3

# Diffusion models (defaults match the original app)
MABIX_SD_MODEL=SG161222/Realistic_Vision_V5.1_noVAE
MABIX_ANIMATEDIFF_ADAPTER=guoyww/animatediff-motion-adapter-v1-5-2

# Storage
# MABIX_DATA_DIR=./storage
# MABIX_LEGACY_VIDEO_DIR=./videos
MABIX_MAX_UPLOAD_MB=2048
# MABIX_YOUTUBE_TOKEN=./youtube_token.json
# MABIX_LOGO_URL=https://mabixai.in/assets/images/mabix-logo.png
# MABIX_FONT_PATH=./ttfFile/DejaVuSans-Bold.ttf

# ======================= MabixAI RoboCat =======================
# Run: uvicorn mabixai.backend.main:app --host 0.0.0.0 --port 8000
MABCAT_SECRET_KEY=
MABCAT_ADMIN_EMAIL=admin@mabix.local
# Development default password is "admin"; REQUIRED in production:
MABCAT_ADMIN_PASSWORD=
# DATABASE_URL=postgresql+psycopg://mabcat:change-me@postgres/mabcat
# MABCAT_DATA_DIR=./storage/mabcat

# Teaching LLM: ollama | openai | gemini | none (offline teaching from extracted content)
MABCAT_LLM_PROVIDER=ollama
MABCAT_OLLAMA_MODEL=llama3
OPENAI_API_KEY=
MABCAT_OPENAI_MODEL=gpt-4o-mini
GEMINI_API_KEY=
MABCAT_GEMINI_MODEL=gemini-1.5-flash
# Optional embeddings for hybrid retrieval: ollama:nomic-embed-text | openai:text-embedding-3-small
MABCAT_EMBEDDINGS=
MABCAT_OCR_LANGS=eng+mal+hin+tam+kan

# Speech-to-text
MABCAT_STT_PROVIDERS=indicconformer,faster-whisper,openai
MABCAT_STT_ROUTES=en:faster-whisper,ml:indicconformer,hi:indicconformer,*:faster-whisper
MABCAT_STT_CLOUD_FALLBACK=0
MABCAT_WHISPER_MODEL=large-v3
MABCAT_WHISPER_DEVICE=auto
MABCAT_WHISPER_COMPUTE=auto
MABCAT_INDIC_MODEL=ai4bharat/indic-conformer-600m-multilingual
MABCAT_INDIC_DECODER=rnnt
MABCAT_OPENAI_STT_MODEL=gpt-4o-mini-transcribe
# Set to the current published price per audio minute:
MABCAT_OPENAI_STT_USD_PER_MIN=0.003
MABCAT_VAD=webrtc
MABCAT_EOU_MS=800
MABCAT_NOISE_REDUCTION=highpass
# Raw child audio is NOT stored unless enabled (and only with parental voice consent):
MABCAT_STORE_AUDIO=0
MABCAT_AUDIO_RETENTION_HOURS=24

# Text-to-speech (first available engine per language wins)
MABCAT_TTS_PROVIDERS=kokoro,piper,espeak
MABCAT_KOKORO_VOICE=af_heart
# MABCAT_PIPER_MODELS=en=/models/piper/en_US-lessac-medium.onnx,hi=/models/piper/hi_IN-priyamvada-medium.onnx
# Load models at startup: stt,tts
MABCAT_WARMUP=
